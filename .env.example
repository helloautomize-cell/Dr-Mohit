# Set true only on the production deploy (Phase 10). Anything else stays noindexed.
SITE_INDEXABLE=false
NEXT_PUBLIC_SITE_URL=https://guptahospitalbathinda.com

# --- Appointment form (app/actions/appointment.ts) -------------------------
# Resend API key — without it the form posts but returns the "unavailable"
# state (call/WhatsApp fallback) instead of emailing.
RESEND_API_KEY=
# Clinic inbox for appointment notifications (defaults to SITE.email).
APPOINTMENT_EMAIL_TO=
# Verified sender on the Resend account, e.g. "Gupta Hospital <appointments@yourdomain.com>"
APPOINTMENT_EMAIL_FROM=
# Cloudflare Turnstile — set BOTH or neither. The widget only renders when
# the public site key is present; the server only verifies when the secret is.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (consent-gated GA4, Phase 7) --------------------------------
# GA4 measurement id. Nothing loads until the cookie banner grants analytics;
# ad_storage stays denied regardless. Leave empty to keep GA fully off.
NEXT_PUBLIC_GA_ID=
